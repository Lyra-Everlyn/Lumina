<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Khi RadioButton được chọn (Checked) -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_purple_light" />
            <stroke android:width="1.5dp" android:color="@color/primary_purple" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Trạng thái mặc định (Unchecked) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="1dp" android:color="@color/divider_color" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>